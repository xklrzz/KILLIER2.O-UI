-- Auto Win 
local autoWin = false
local player = game.Players.LocalPlayer
add_switch("Auto Farm Win ", function() 
		autoWin = true
		while autoWin do
				local root = player.Character:FindFirstChild("HumanoidRootPart")
				if root then
						root.CFrame = CFrame.new(-14261, 30, math.random(436, 445))
				end
				wait(0.01)
		end
		end, function()
				autoWin = false
		end)
		
-- Auto Rebirth
local autoRebirth
add_switch("Auto Rebirth ", function()
		autoRebirth = true
		while autoRebirth do
				local Event = game:GetService("ReplicatedStorage").Events.RebirthRequest
				Event:InvokeServer()
				task.wait(2)
		end end, function() autoRebirth = false end)

