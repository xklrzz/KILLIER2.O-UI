local data = {}

local function autofarm(trigger)
    while data[trigger] do
        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(22, 6, -32)
        local Event = game:GetService("ReplicatedStorage").Remotes.Plot_EquipBest
        Event:InvokeServer()
        wait(0.5)

        local Event = game:GetService("ReplicatedStorage").Remotes.Throw_Start
        Event:InvokeServer()
        wait(0.5)

        local Event = game:GetService("ReplicatedStorage").Remotes.Throw_MeterStarted
        Event:FireServer()
        wait(0.5)

        local Event = game:GetService("ReplicatedStorage").Remotes.Throw_Resolve
        Event:InvokeServer(
            .9997373332
        )
        wait(1)

        local Event = game:GetService("ReplicatedStorage").Remotes.Throw_Revealed
        Event:FireServer()
        wait(1)

        local Event = game:GetService("ReplicatedStorage").Remotes.Throw_Complete
        Event:InvokeServer()
        wait(2)
    end
end

